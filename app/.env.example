# Copy to app/.env.local (gitignored) and fill in. Never commit real values.
# Variables are validated once at server start by src/lib/env.ts (ADR-000 §7).

# Required: OpenRouter key for all LLM calls (set a spending cap on the key)
OPENROUTER_API_KEY=
# Required: default model for all steps
LLM_MODEL=openai/gpt-6-luna
# Optional per-step overrides (default to LLM_MODEL)
VISION_MODEL=
DECISION_MODEL=
CHAT_MODEL=
# Required: HMAC key for the case token, >= 32 random bytes; generate with: openssl rand -base64 32
CASE_SIGNING_SECRET=
# Optional: time zone for "today" and the policy window (default Europe/Warsaw)
APP_TIMEZONE=Europe/Warsaw
# Test-only (ADR-003 A-05): never set outside local tests
# ALLOW_TEST_BUDGET=true
# CASE_BUDGET_MS=1000

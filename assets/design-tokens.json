{
  "$source": "https://www.tauron.pl/dla-domu (extracted 2026-11-25, desktop 1280px)",
  "colors": {
    "brand": {
      "primary": "#E2007A",
      "accent": "#73DADF",
      "accentAlt": "#6AE2E5",
      "error": null,
      "success": null,
      "warning": "#FFEB7C"
    },
    "background": {
      "default": "#FFFFFF",
      "light": "#FAFAFA",
      "accentLight": "#DCF3F4",
      "accentLighter": "#D0F5F6",
      "inverse": "#000000",
      "overlay": "rgba(0, 0, 0, 0.5)"
    },
    "text": {
      "primary": "#000000",
      "secondary": "#272727",
      "muted": "#555555",
      "disabled": "#ABABAB",
      "brand": "#E2007A",
      "onDark": "#FFFFFF",
      "onBrand": "#FFFFFF"
    },
    "border": {
      "default": "#B7B7B7",
      "light": "#DADADA",
      "accent": "#73DADF",
      "onDark": "#FFFFFF"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "\"Titillium Web\", Arial, sans-serif",
      "icons": "icon-font"
    },
    "fontWeights": { "extralight": 200, "light": 300, "regular": 400, "semibold": 600, "bold": 700, "black": 900 },
    "fontSize": {
      "sm": "14px",
      "base": "16px",
      "md": "18px",
      "lg": "20px",
      "xl": "22px",
      "2xl": "26px",
      "3xl": "32px",
      "4xl": "40px"
    },
    "lineHeight": { "tight": "1", "snug": "1.2", "base": "1.4", "relaxed": "1.6" },
    "textStyles": {
      "heroTitle": { "fontSize": "26px", "fontWeight": 600, "lineHeight": "1", "color": "#FFFFFF" },
      "sectionTitle": { "fontSize": "32px", "fontWeight": 600, "lineHeight": "1.2", "color": "#000000" },
      "display": { "fontSize": "40px", "fontWeight": 700, "lineHeight": "1" },
      "cardTitle": { "fontSize": "18px", "fontWeight": 600, "lineHeight": "1.2" },
      "body": { "fontSize": "16px", "fontWeight": 400, "lineHeight": "1.4" },
      "bodyLarge": { "fontSize": "18px", "fontWeight": 400, "lineHeight": "1.4" },
      "caption": { "fontSize": "14px", "fontWeight": 400, "lineHeight": "1.4" },
      "eyebrow": { "fontSize": "14px", "fontWeight": 400, "lineHeight": "1.4", "color": "#272727" }
    }
  },
  "spacing": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "20px", "6": "24px", "7": "28px", "8": "32px",
    "10": "40px", "12": "48px", "14": "56px"
  },
  "borderRadius": {
    "none": "0px",
    "sm": "4px",
    "md": "5px",
    "lg": "20px",
    "xl": "40px",
    "full": "250px",
    "circle": "50%"
  },
  "shadows": {
    "card": "0px 10px 24px 0px rgba(33, 33, 33, 0.1)",
    "raised": "0px 1px 20px 0px rgba(31, 31, 31, 0.24)",
    "popover": "0px 4px 16px 0px rgba(0, 0, 0, 0.15)"
  },
  "components": {
    "button": {
      "primary": {
        "backgroundColor": "#E2007A",
        "color": "#FFFFFF",
        "padding": "4px 10px",
        "borderRadius": "4px",
        "fontSize": "16px",
        "fontWeight": 600,
        "height": "30px"
      },
      "inverse": {
        "backgroundColor": "#FFFFFF",
        "color": "#E2007A",
        "padding": "13px 5px",
        "borderRadius": "4px",
        "fontSize": "20px",
        "fontWeight": 600,
        "lineHeight": "28px",
        "height": "54px",
        "usage": "CTA on magenta hero background"
      },
      "link": {
        "backgroundColor": "transparent",
        "color": "#E2007A",
        "fontSize": "16px",
        "fontWeight": 600
      }
    },
    "card": {
      "backgroundColor": "#FFFFFF",
      "borderRadius": "20px",
      "boxShadow": "0px 10px 24px 0px rgba(33, 33, 33, 0.1)",
      "padding": "20px",
      "highlighted": { "border": "2px solid #73DADF" }
    },
    "header": {
      "backgroundColor": "#FFFFFF",
      "topLinks": { "fontSize": "16px", "fontWeight": 600, "color": "#272727", "activeColor": "#E2007A" },
      "mainNav": { "fontSize": "22px", "fontWeight": 600, "color": "#272727" },
      "logoWidth": "109px"
    },
    "nav": { "color": "#272727", "fontSize": "22px", "fontWeight": 600, "activeColor": "#E2007A" },
    "hero": { "backgroundColor": "#E2007A", "color": "#FFFFFF" },
    "alertBar": { "backgroundColor": "#FFEB7C", "color": "#000000", "fontSize": "14px" },
    "tabs": { "fontSize": "20px", "fontWeight": 400, "height": "80px", "color": "#000000" },
    "footer": { "backgroundColor": "#FFFFFF", "fontSize": "16px", "lineHeight": "1.4", "color": "#000000", "legalLinkColor": "#E2007A" },
    "input": { "border": "1px solid #B7B7B7", "borderRadius": "5px", "fontSize": "16px" }
  }
}

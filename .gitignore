.DS_Store
# Agent Skills: skills-lock.json is committed as the source of truth (source repo and
# commit for each installed skill); restore them with `npx skills install`.
# Installed copies in .agents/skills/ are ignored. Skills written in this repo have no
# remote source, so each one is un-ignored explicitly below.
# .claude/skills/ holds the CLI's links to them; .claude/worktrees/ holds agent worktrees.
.agents/skills/*
!.agents/skills/deep-source-research/
.claude/skills/
.claude/worktrees/
__pycache__/
*.pyc
.playwright-cli
playwright-report/
test-results/
playwright/.cache/

# Local Codex history, credentials and runtime state; keep shared config and rules.
.codex/auth.json
.codex/sessions/
.codex/archived_sessions/
.codex/history.jsonl
.codex/session_index.jsonl
.codex/log/
.codex/logs/
.codex/tmp/
.codex/*.sqlite*

# Private agent briefs and Java build artifacts
.agent-briefs/
**/target/
*.class
/.idea
# Playwright CLI output (may contain credentials)
.playwright-cli/
